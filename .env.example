# Copy to .env.local and fill in. FINN runs fully without a key (Tier 0 + seed cache);
# the key unlocks Tier 1 (Flash) classification/extraction and the Tier 2 (Pro) narrative audit.
GEMINI_API_KEY=

# Optional model overrides (defaults shown). If a pinned model is retired, FINN falls back
# to the rolling aliases gemini-flash-latest / gemini-pro-latest automatically.
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro
